# ---- Core ------------------------------------------------------------------
# REQUIRED in production: long random string (encrypts stored connector secrets).
SECRET_KEY=
# Public URL of the web app (links in e-mails and alerts; CORS origin).
APP_URL=http://localhost:8080
AUTH_REQUIRED=true
REGISTRATION_OPEN=true
REQUIRE_EMAIL_VERIFICATION=false
DEFAULT_PLAN=free
SUPERUSER_EMAILS=
POSTGRES_PASSWORD=change-me
# live | demo | auto (auto = live feeds, falling back to synthetic data when unreachable)
DATA_MODE=auto

# ---- Fire detection feeds ---------------------------------------------------
FIRMS_MAP_KEY=
FIRMS_SOURCES=VIIRS_NOAA20,VIIRS_NOAA21,VIIRS_SNPP,MODIS
REGION_BBOX=
GOES_ENABLED=true
GOES_SATELLITES=goes19,goes18
JAXA_FTP_USER=
JAXA_FTP_PASSWORD=
LSASAF_USER=
LSASAF_PASSWORD=
POLL_MINUTES=10
RETENTION_HOURS=9600

# ---- Earth observation (organisations can also add their own as connectors) --
GEE_SERVICE_ACCOUNT_JSON=
GEE_PROJECT=
GFW_API_KEY=
STAC_API_URL=https://earth-search.aws.element84.com/v1
SENTINEL2_MAX_CLOUD=40
TERRAIN_ENABLED=true
MODEL_PATH=/data/ignition_model.joblib

# ---- E-mail (verification, password reset, invites, alerts, digests) --------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SENDGRID_API_KEY=
TELEGRAM_BOT_TOKEN=

# ---- Background jobs ---------------------------------------------------------
RISK_JOB_HOURS=6
VEGETATION_JOB_HOURS=24
THREAT_CHECK_MINUTES=30

# ---- Billing (optional, Stripe) ----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# live | demo | auto (auto = live feeds, falling back to synthetic data if unreachable)
DATA_MODE=auto
POLL_MINUTES=10
RETENTION_HOURS=72

# NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/map_key/). Optional: without it the
# public global 24 h files are used. With it, REGION_BBOX subsets are fetched server-side.
FIRMS_MAP_KEY=
FIRMS_SOURCES=VIIRS_NOAA20,VIIRS_NOAA21,VIIRS_SNPP,MODIS
# west,south,east,north — restrict ingestion to your region (recommended)
REGION_BBOX=

# Geostationary GOES-East/West fire product (Americas), every 10 min
GOES_ENABLED=true
GOES_SATELLITES=goes19,goes18

# Notifications
PUBLIC_URL=http://localhost:8000
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com

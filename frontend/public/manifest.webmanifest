{
  "name": "Firealerts",
  "short_name": "Firealerts",
  "description": "Satellite wildfire intelligence: fire detections, spread forecasts, fire danger and alerts for your forests.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0d12",
  "theme_color": "#0b0d12",
  "categories": ["weather", "utilities", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Live map", "url": "/app/map", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Alerts", "url": "/app/alerts", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
